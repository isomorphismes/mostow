#!/usr/bin/env grease
var root = $(git -C "$[ARGV[0]]" rev-parse --show-toplevel)
var grease = ENV.MOSTOW_GREASE
test -x "$grease"
for kernel in (['m004', 'octagon', 'pants', 'distortion']) {
  "$grease" "$root/tools/test-kernel.grease" "$root" "$kernel"
}
for witness in (['figure-eight-completeness/test-mutations.grease',
                'genus-two-octagon/test-mutants.grease',
                'fenchel-nielsen/test-mutants.grease',
                'distortion-coarse/test-mutants.grease']) {
  "$grease" "$root/examples/autogenerated/$witness" "$root"
}
printf '\033[32mPASS\033[0m four mathematical kernels and constraint-removal mutations; independent acceptance remains separate\n'

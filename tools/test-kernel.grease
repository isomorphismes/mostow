#!/usr/bin/env grease
var root = $(git -C "$[ARGV[0]]" rev-parse --show-toplevel)
var kernel = ARGV[1]
var compiler = ENV.MOSTOW_HOST_COMPILER
var source = ''
var fixture = ''
if test "$kernel" = distortion {
  setvar source = 'mostow_distortion'; setvar fixture = 'distortion-coarse/test_distortion.c'
} elif test "$kernel" = octagon {
  setvar source = 'mostow_octagon'; setvar fixture = 'genus-two-octagon/test_octagon.c'
} elif test "$kernel" = pants {
  setvar source = 'mostow_pants'; setvar fixture = 'fenchel-nielsen/test_pants.c'
} elif test "$kernel" = m004 {
  setvar source = 'mostow_m004'; setvar fixture = 'figure-eight-completeness/test_m004.c'
} else {
  printf '\033[31mFAIL\033[0m unknown mathematical kernel\n'; exit 2
}
test -x "$compiler"
test -f "$root/icky/$source.c"
test -f "$root/examples/autogenerated/$fixture"
mkdir -p "$root/build/host"
"$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic \
  -I "$root/native" "$root/icky/$source.c" "$root/examples/autogenerated/$fixture" \
  -lm -o "$root/build/host/test-$kernel"
"$root/build/host/test-$kernel"
sha256sum "$compiler" "$root/icky/$source.c" "$root/examples/autogenerated/$fixture" "$root/build/host/test-$kernel"

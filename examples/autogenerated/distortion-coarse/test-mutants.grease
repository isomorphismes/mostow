#!/usr/bin/env grease
var root = $(git -C "$[ARGV[0]]" rev-parse --show-toplevel)
var compiler = ENV.MOSTOW_HOST_COMPILER
var output = "$root/build/host/distortion-mutants"
mkdir -p "$output"
test -x "$compiler"
# Mutate the mathematical implementation while keeping the independent test
# and its tolerances unchanged. Every candidate must compile successfully;
# rejection must then name the intended mathematical witness.
for mutant in ([
  ['erase-anisotropy', 's/result.dilatation ← dilatation;/result.dilatation ← 1;/', 'DIAGONAL_STRETCH'],
  ['erase-target-metric', r's/status ← metric_frame(target_metric,\&target);/status ← metric_frame(((void)target_metric,source_metric),\&target);/', 'METRIC_BASIS'],
  ['erase-orientation', 's/result.orientation ← determinant>0 ? 1 : -1;/result.orientation ← 1;/', 'REFLECTION'],
  ['erase-differential-in-image', r's/const MostowTangentPoint image ← {fma(measured.xx,source.x,measured.xy\*source.y),/const MostowTangentPoint image ← {source.x,/', 'GENERAL_METRIC_IMAGE'],
  ['floor-instead-of-nearest', 's/const double nearest ← lower+(real-lower>0.5 ? 1 : 0);/const double nearest ← lower;/', 'NEAREST_INTEGER'],
  ['too-small-density', 's/return (MostowCoarseConstants){1,0,0.5};/return (MostowCoarseConstants){1,0,0.49};/', 'COARSE_CONSTANTS']
]) {
  var name = mutant[0]
  sed "$[mutant[1]]" "$root/icky/mostow_distortion.c" > "$output/$name.c"
  if cmp -s "$root/icky/mostow_distortion.c" "$output/$name.c" {
    printf '\033[31mFAIL\033[0m mutation did not change source: %s\n' "$name"
    exit 1
  }
  "$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic \
    -I "$root/native" "$output/$name.c" \
    "$root/examples/autogenerated/distortion-coarse/test_distortion.c" \
    -lm -o "$output/$name"
  if "$output/$name" > "$output/$name.log" 2>&1 {
    printf '\033[31mFAIL\033[0m implementation mutant passed: %s\n' "$name"
    exit 1
  }
  rg -F "FAIL $[mutant[2]]" "$output/$name.log"
  printf '\033[32mPASS\033[0m rejected %s at %s\n' "$name" "$[mutant[2]]"
}
printf '\033[32mPASS\033[0m six compiled distortion/coarse mutants rejected by unchanged mathematical fixtures\n'

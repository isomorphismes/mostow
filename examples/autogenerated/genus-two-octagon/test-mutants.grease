#!/usr/bin/env grease
var root = $(git -C "$[ARGV[0]]" rev-parse --show-toplevel)
var compiler = ENV.MOSTOW_HOST_COMPILER
var output = "$root/build/host/octagon-mutants"
mkdir -p "$output"
for mutant in ([['ignore-pairing', 's/result.pairing_error<1e-8/1/', '!mostow_octagon_diagnostics(&identity_pairings).valid'],
                ['ignore-orientation', 's/result.orientation_error<1e-8/1/', 'reflection_diagnostic.available && !reflection_diagnostic.valid'],
                ['ignore-lift', r's/if (fabs(reconstructed.entry/if (0 \&\& fabs(reconstructed.entry/', '!mostow_octagon_navigator_valid(&navigator)']]) {
  var name = mutant[0]
  sed "$[mutant[1]]" "$root/icky/mostow_octagon.c" > "$output/$name.c"
  if cmp -s "$root/icky/mostow_octagon.c" "$output/$name.c" {
    printf '\033[31mFAIL\033[0m mutation made no source change: %s\n' "$name"
    exit 1
  }
  "$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic \
    -I "$root/native" "$output/$name.c" \
    "$root/examples/autogenerated/genus-two-octagon/test_octagon.c" -lm -o "$output/$name"
  if "$output/$name" > "$output/$name.log" 2>&1 {
    printf '\033[31mFAIL\033[0m octagon mutant passed: %s\n' "$name"
    exit 1
  }
  rg -F "$[mutant[2]]" "$output/$name.log"
}
printf '\033[32mPASS\033[0m omitted endpoint/orientation constraints and forged-lift acceptance rejected\n'

#!/usr/bin/env grease
var root = $(git -C "$[ARGV[0]]" rev-parse --show-toplevel)
var compiler = ENV.MOSTOW_HOST_COMPILER
var output = "$root/build/host/fn-mutants"
mkdir -p "$output"
# Mutate the implementation; keep the algebraic/geometric witnesses unchanged.
for mutant in ([['ignore-twists',
                 r's/axis_translation(reflections\[cuff\],parameters->twists\[cuff\])/axis_translation(reflections[cuff],0)/',
                 'fabs(fabs(twisted.transverse_traces[0])-8)<1e-10'],
                ['allow-zero-cuff',
                 r's/parameters->lengths\[cuff\]<=0/parameters->lengths[cuff]<0/',
                 '!mostow_pants_state_valid(&parameters)'],
                ['wrong-arclength',
                 r's/const double first_weight ← sinh((1-fraction)\*length)÷denominator;/const double first_weight ← 1-fraction;/',
                 'fabs(disk_distance(first,middle)-half_cuff÷4)<1e-11'],
                ['lose-one-pant',
                 r's/diagnostic.area ← 4\*(4\*pants_pi-angle_sum);/diagnostic.area ← 2*(4*pants_pi-angle_sum);/',
                 'fabs(diagnostic.area-4*acos(-1.0))<1e-8']]) {
  var name = mutant[0]
  sed "$[mutant[1]]" "$root/icky/mostow_pants.c" > "$output/$name.c"
  if cmp -s "$root/icky/mostow_pants.c" "$output/$name.c" {
    printf '\033[31mFAIL\033[0m mutation did not change implementation: %s\n' "$name"
    exit 1
  }
  "$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic \
    -I "$root/native" "$output/$name.c" \
    "$root/examples/autogenerated/fenchel-nielsen/test_pants.c" \
    -lm -o "$output/$name"
  if "$output/$name" > "$output/$name.log" 2>&1 {
    printf '\033[31mFAIL\033[0m mathematical mutant passed: %s\n' "$name"
    exit 1
  }
  rg -F "$[mutant[2]]" "$output/$name.log"
}
printf '\033[32mPASS\033[0m removed twist/domain/geodesic/area requirements rejected by unchanged FN witnesses\n'

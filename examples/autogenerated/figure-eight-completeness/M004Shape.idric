module M004Shape

-- Explicit host prototype, not a Float16 default or an Android ABI claim.
PrototypeScalar : Type
PrototypeScalar = Double

record IdealShape where
  constructor ShapeInUpperHalfPlane
  real_part : PrototypeScalar
  imaginary_part : PrototypeScalar

complete_ideal_shape : IdealShape
complete_ideal_shape = ShapeInUpperHalfPlane 0.5 (sqrt 3 ÷ 2)


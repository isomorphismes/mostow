#!/usr/bin/env grease
var root = $(git -C "$[ARGV[0]]" rev-parse --show-toplevel)
var compiler = ENV.MOSTOW_HOST_COMPILER
var output = "$root/build/host/m004-mutants"
mkdir -p "$output"
# Each candidate must compile, then fail the unchanged mathematical witness.
for mutant in ([['reciprocal-face', r's/reverse\[permutation\[vertex\]\]!=vertex/reverse[permutation[vertex]]==999/', '!mostow_m004_check_topology(&bad).pairings_valid'],
                ['primitive-basis', 's/lattice_index==1/lattice_index>=0/', 'nonprimitive.peripheral_cycles_valid && !nonprimitive.peripheral_basis_valid'],
                ['peripheral-equations', r's/if (peripheral_exponents\[curve\]\[column\]!=shape_exponents\[curve+2\]\[column\])/if (0 \&\& peripheral_exponents[curve][column]!=shape_exponents[curve+2][column])/', 'different_marking.peripheral_basis_valid && !different_marking.peripheral_equations_match'],
                ['volume-half', r's/return sign\*sum;/return sign*sum*0.5;/', '2*regular.volume-2.02988321281930725004240510854904057188'],
                ['shear-conformal', r's/(1-shear)\*shape.imaginary/(1+shear)*shape.imaginary/', 'transformed.imaginary-shapes[0].imaginary*0.6'],
                ['ignore-cusps', r's/if (diagnostic.residual\[equation\]>residual_tolerance)/if (equation<2 \&\& diagnostic.residual[equation]>residual_tolerance)/', '!incomplete.complete_to_tolerance']]) {
  var name = mutant[0]
  sed "$[mutant[1]]" "$root/icky/mostow_m004.c" > "$output/$name.c"
  if cmp -s "$root/icky/mostow_m004.c" "$output/$name.c" {
    printf '\033[31mFAIL\033[0m mutation did not change source: %s\n' "$name"
    exit 1
  }
  "$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic \
    -I "$root/native" "$output/$name.c" \
    "$root/examples/autogenerated/figure-eight-completeness/test_m004.c" \
    -lm -o "$output/$name"
  if "$output/$name" > "$output/$name.log" 2>&1 {
    printf '\033[31mFAIL\033[0m mathematical mutant passed: %s\n' "$name"
    exit 1
  }
  rg -F -- "$[mutant[2]]" "$output/$name.log"
}
printf '\033[32mPASS\033[0m reciprocal pairing, primitive peripheral basis, volume, boundary distortion and cusp constraints rejected when removed\n'
